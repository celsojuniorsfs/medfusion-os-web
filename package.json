{
  "name": "medfusion-os-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run generate:api-types:remote",
    "start": "ng serve",
    "build": "npm run generate:api-types:remote && ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api-types:remote",
    "test": "ng test",
    "generate:api-types": "openapi-typescript ../medfusion-os-api/docs/openapi.yaml -o src/app/core/api-types.ts",
    "generate:api-types:remote": "openapi-typescript https://raw.githubusercontent.com/celsojuniorsfs/medfusion-os-api/main/docs/openapi.yaml -o src/app/core/api-types.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.45.0",
    "@ngrx/signals": "^22.0.0",
    "@spartan-ng/brain": "^1.4.1",
    "clsx": "^2.1.1",
    "luxon": "^3.7.2",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
